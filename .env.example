# Browser-safe Supabase configuration. The publishable/anon key is intentionally
# public; Row Level Security in supabase/migrations protects application data.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Server-only values used by server.ts to verify Bearer tokens for /api/chat.
# Do not prefix these with VITE_. These may use the same project URL and
# publishable key as above; a service-role key is neither required nor supported.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
GEMINI_API_KEY=
