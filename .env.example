# ==============================================================================
# BAGBUDDY — ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env and fill in your actual production/staging values.
# NEVER commit the actual .env file to version control.
# ==============================================================================

# Flask Application Settings
# Set FLASK_ENV to "production" and DEBUG to "False" on live servers
FLASK_ENV=production
DEBUG=False
SECRET_KEY=generate-a-strong-random-secret-key-for-session-cookies

# Supabase Production Infrastructure
# Obtain these from: Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-public-anon-key

# Supabase Service Role Key (Optional: Server-side only, never expose to browser)
# Used for administrative operations bypassing RLS when required
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# External APIs (Optional)
WEATHER_API_KEY=your-openweather-or-weather-api-key
AI_API_KEY=your-llm-or-ai-api-key
