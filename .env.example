# ==============================================================================
# BAGBUDDY — PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and replace the placeholder values with your actual keys.
# NEVER commit your actual .env file with real secrets to version control.
# ==============================================================================

# Supabase Production Infrastructure (REQUIRED FOR PRODUCTION)
# Retrieve these from your Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=sb_publishable_your_anon_key_here
SUPABASE_ANON_KEY=sb_publishable_your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=sb_secret_your_service_role_key_here

# Flask Configuration (Used for signing user session cookies)
FLASK_ENV=production
DEBUG=False
SECRET_KEY=bagbuddy-production-secret-key-change-in-env

# External Integration APIs
# WEATHER_API_KEY: Optional for WeatherAPI.com. If left blank, BagBuddy automatically
# uses Open-Meteo (free global meteorological forecast, no key required).
WEATHER_API_KEY=your_weather_api_key_here
WEATHER_PROVIDER=open-meteo
# Gemini is used only by the Flask backend; never expose this key in frontend code.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Legacy fallback only. Prefer GEMINI_API_KEY above.
AI_API_KEY=
